{
  "headers": [
    {
      "source": "/pocket/client-metadata.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/pocket/sw.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/easel/client-metadata.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/easel/sw.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/wall/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src https: data:; connect-src https:"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pocket",
      "destination": "/pocket/",
      "permanent": false
    },
    {
      "source": "/easel",
      "destination": "/easel/",
      "permanent": false
    },
    {
      "source": "/catalogue",
      "destination": "/catalogue/",
      "permanent": false
    },
    {
      "source": "/wall",
      "destination": "/wall/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/wall/:actor/:rkey", "destination": "/wall/index.html" },
    { "source": "/wall/:actor/:rkey/", "destination": "/wall/index.html" },
    { "source": "/wall/:actor/", "destination": "/wall/index.html" },
    { "source": "/wall/:actor", "destination": "/wall/index.html" }
  ]
}
