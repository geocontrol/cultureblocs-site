{
  "headers": [
    {
      "source": "/week/client-metadata.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/went/client-metadata.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/pocket/client-metadata.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/pocket/sw.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/easel/client-metadata.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/easel/sw.js",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/wall/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src https: data:; connect-src https:"
        }
      ]
    },
    {
      "source": "/events/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src https: data:; connect-src 'self' https:"
        }
      ]
    },
    {
      "source": "/events/(.*)/events.json",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/went/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src https: data: blob:; connect-src 'self' https:; form-action 'self'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/.well-known/did.json",
      "headers": [
        {
          "key": "content-type",
          "value": "application/json"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        },
        {
          "key": "cache-control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/week/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src https: data: blob:; connect-src 'self' https:; form-action 'self'; base-uri 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pocket",
      "destination": "/pocket/",
      "permanent": false
    },
    {
      "source": "/easel",
      "destination": "/easel/",
      "permanent": false
    },
    {
      "source": "/catalogue",
      "destination": "/catalogue/",
      "permanent": false
    },
    {
      "source": "/wall",
      "destination": "/wall/",
      "permanent": false
    },
    {
      "source": "/events",
      "destination": "/events/",
      "permanent": false
    },
    {
      "source": "/events/frieze-week-london",
      "destination": "/events/frieze-week-london/",
      "permanent": false
    },
    {
      "source": "/went",
      "destination": "/went/",
      "permanent": false
    },
    {
      "source": "/w/fwl",
      "destination": "/events/frieze-week-london/",
      "permanent": false
    },
    {
      "source": "/w/fwl/:key",
      "destination": "/went/?dir=frieze-week-london&e=:key",
      "permanent": false
    },
    {
      "source": "/events/paris-art-week",
      "destination": "/events/paris-art-week/",
      "permanent": false
    },
    {
      "source": "/w/paw",
      "destination": "/events/paris-art-week/",
      "permanent": false
    },
    {
      "source": "/w/paw/:key",
      "destination": "/went/?dir=paris-art-week&e=:key",
      "permanent": false
    },
    {
      "source": "/events/london-film-festival",
      "destination": "/events/london-film-festival/",
      "permanent": false
    },
    {
      "source": "/w/lff",
      "destination": "/events/london-film-festival/",
      "permanent": false
    },
    {
      "source": "/w/lff/:key",
      "destination": "/went/?dir=london-film-festival&e=:key",
      "permanent": false
    },
    {
      "source": "/week",
      "destination": "/week/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/wall/:actor/:rkey",
      "destination": "/wall/index.html"
    },
    {
      "source": "/wall/:actor/:rkey/",
      "destination": "/wall/index.html"
    },
    {
      "source": "/wall/:actor/",
      "destination": "/wall/index.html"
    },
    {
      "source": "/wall/:actor",
      "destination": "/wall/index.html"
    },
    {
      "source": "/xrpc/app.bsky.feed.getFeedSkeleton",
      "destination": "/api/xrpc/getFeedSkeleton"
    },
    {
      "source": "/xrpc/app.bsky.feed.describeFeedGenerator",
      "destination": "/api/xrpc/describeFeedGenerator"
    }
  ]
}
